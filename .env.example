# PakSoft Environment Variables
# Copy this file to .env.local and fill in the values

# Database (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/paksoft"

# Admin Authentication
# IMPORTANT: Change these values in production!
ADMIN_USER="admin"
ADMIN_PASS="admin123"

# reCAPTCHA (optional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Analytics (optional)
NEXT_PUBLIC_GA_ID=""

# Site URL
NEXT_PUBLIC_SITE_URL="https://paksoft.com.tr"
