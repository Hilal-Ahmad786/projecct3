# PakSoft Environment Variables
# Copy this file to .env.local and fill in the values

# Database (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/paksoft"

# Admin Authentication
# IMPORTANT: Change these values in production!
ADMIN_USER="admin"
ADMIN_PASS="admin123"

# reCAPTCHA (optional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Analytics & Ads (all optional — each tag loads only when its ID is set)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""          # GA4 (G-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=""              # Google Ads (AW-XXXXXXXXXX) — needed for conversion tracking
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=""   # conversion label for the "lead" action
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_FB_PIXEL_ID=""
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
NEXT_PUBLIC_CLARITY_ID=""

# Site URL
NEXT_PUBLIC_SITE_URL="https://www.paksofts.com"
